# Target URL to scrape.
# Optional - defaults to https://quotes.toscrape.com/js/
TARGET_URL=https://quotes.toscrape.com/js/

# Bright Data proxy credentials (all three required to enable the proxy).
# Optional - when unset, scraping runs without a proxy.
BRIGHT_DATA_CUSTOMER_ID=
BRIGHT_DATA_ZONE=
BRIGHT_DATA_PASSWORD=
